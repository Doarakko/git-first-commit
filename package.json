{
  "name": "git-first-commit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt",
    "lint": "oxlint",
    "pages:build": "npx @opennextjs/cloudflare build",
    "preview": "npx @opennextjs/cloudflare preview",
    "deploy": "npx @opennextjs/cloudflare build && npx @opennextjs/cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "d1:migrate": "wrangler d1 migrations apply git-first-commit --local",
    "d1:migrate:remote": "wrangler d1 migrations apply git-first-commit --remote"
  },
  "dependencies": {
    "@next/third-parties": "16.4.6",
    "next": "16.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@octokit/types": "^18.0.0",
    "@opennextjs/cloudflare": "^1.20.18",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^25.9.9",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.1.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  },
  "overrides": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
