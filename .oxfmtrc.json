{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/node_modules",
    "**/.next",
    "**/.open-next",
    "**/.wrangler",
    "**/.vercel",
    "**/*.md",
    "**/*.yml",
    "**/*.yaml",
    "**/*.html",
    "**/*.toml"
  ],
  "overrides": [
    {
      "files": ["*.jsonc"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "sortPackageJson": false
}
